{
  // The whole site is one Worker: it serves the static pages from the repo
  // root and answers /api/* itself. No Pages project, no second origin, so
  // nothing to configure for CORS and one thing to deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sjvsc",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    // The site as it already is: index.html and friends at the repo root.
    // .assetsignore keeps the source and the notes out of what is served.
    "directory": ".",
    "binding": "ASSETS",
    // Serves calendar.html at /calendar, which is how the old Network
    // Solutions URLs keep working without redirect rules.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Neither /api/* nor an uploaded file is on disk, so both
    // have to reach the Worker rather than the asset handler.
    //
    // The rest are the old site's addresses that did not survive the
    // move. Nothing is on disk at any of them, so without this the
    // asset handler would answer 404 and the Worker's redirect map
    // would never be consulted. The two German pages are globbed
    // because a browser may send them encoded or decoded.
    "run_worker_first": [
      "/api/*",
      "/uploads/*",

      "/hall-rental",
      "/oktoberfest",
      "/jass",
      "/children-s-christmas-party",
      "/almond-blossom-dance",
      "/west-coast-swiss-wrestling-association",
      "/k*-kochbuch",

      "/schwingfests",
      "/eidgen*-2022",
      "/playground",
      "/swiss-miss",
      "/may-birthday-celebration",
      "/jass-game",
      "/jass-game.html"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sjvsc",
      "database_id": "6f9ce508-01e2-4756-b456-052e0a739af9",
      "migrations_dir": "db/migrations"
    }
  ],

  // The workers.dev address is how the club sees the site before the domain
  // moves. Preview URLs are off: every deployed version would otherwise get
  // its own public address, and there is no reason for several public copies
  // of the club's site to exist at once.
  // The club's own address. A custom domain hands the whole hostname to
  // this Worker and keeps the certificate renewed; www is here too so an
  // old link or a typed "www." still arrives, and the Worker sends it on
  // to the bare domain so there is one canonical address rather than two
  // copies of the site.
  "routes": [
    { "pattern": "sjvscriponswiss.com", "custom_domain": true },
    { "pattern": "www.sjvscriponswiss.com", "custom_domain": true }
  ],

  // Kept on. It is how the board reached the site before the domain moved,
  // and it stays useful as a way in if the domain is ever mid-change.
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true },

  "vars": {
    // The Clerk instance the admin signs in against. This is the production
    // instance, which lives on the club's own domain: the sign-in page is
    // served from clerk.sjvscriponswiss.com rather than a clerk.accounts.dev
    // address, and its tokens are the only ones this Worker will accept.
    //
    // The keys themselves are secrets, not vars: CLERK_JWT_KEY, which the
    // Worker checks session tokens against, and CLERK_AUTHORIZED_PARTIES,
    // the origins a token may have been minted for. Both are set with
    // `wrangler secret put` and neither is in this file. Without
    // CLERK_JWT_KEY every write is refused — see worker/auth.js.
    "CLERK_ISSUER": "https://clerk.sjvscriponswiss.com",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc2p2c2NyaXBvbnN3aXNzLmNvbSQ"
  }
}
